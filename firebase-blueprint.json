{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Minimal private profile document for each authenticated user, anchoring cross-device sync subcollections for both Nocturna and Matinê.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional display name shown in the account menu."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest profile update."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "MovieEntry": {
      "title": "MovieEntry",
      "description": "A user's decision, sentiment, and optional personal rating for a specific movie.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "movieId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Movie identifier matching the document ID."
        },
        "status": {
          "type": "string",
          "enum": ["seen", "watchlist", "skipped"],
          "description": "User decision state for the movie."
        },
        "sentiment": {
          "type": "string",
          "enum": ["liked", "disliked"],
          "description": "Optional liked or disliked signal when status is seen."
        },
        "personalRating": {
          "type": "number",
          "description": "Optional 1 to 5 personal star rating."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the entry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest update."
        }
      },
      "required": ["ownerId", "movieId", "status", "createdAt", "updatedAt"]
    },
    "DiscoveredMovie": {
      "title": "DiscoveredMovie",
      "description": "An AI-curated horror/thriller movie persisted in the user's synced Nocturna discovery library.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Movie ID matching the document ID."
        },
        "title": {
          "type": "string",
          "maxLength": 180
        },
        "originalTitle": {
          "type": "string",
          "maxLength": 180
        },
        "searchTitle": {
          "type": "string",
          "maxLength": 180
        },
        "year": {
          "type": "number"
        },
        "imdbRating": {
          "type": "number"
        },
        "runtimeMinutes": {
          "type": "number"
        },
        "director": {
          "type": "string",
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "maxLength": 80
        },
        "subgenre": {
          "type": "string",
          "enum": [
            "Psicológico",
            "Sobrenatural",
            "Folk & Culto",
            "Thriller Noir",
            "Cósmico & Sci-Fi",
            "Found Footage",
            "Slasher & Sobrevivência",
            "Internacional"
          ]
        },
        "secondaryTag": {
          "type": "string",
          "maxLength": 80
        },
        "obscurity": {
          "type": "string",
          "enum": ["Blockbuster", "Clássico", "Cult", "Lado B", "Raridade"]
        },
        "hasPtBrDub": {
          "type": "boolean"
        },
        "synopsis": {
          "type": "string",
          "maxLength": 600
        },
        "editorialNote": {
          "type": "string",
          "maxLength": 400
        },
        "isAiDiscovered": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "id",
        "title",
        "originalTitle",
        "year",
        "imdbRating",
        "runtimeMinutes",
        "director",
        "country",
        "subgenre",
        "obscurity",
        "hasPtBrDub",
        "synopsis",
        "isAiDiscovered",
        "createdAt",
        "updatedAt"
      ]
    },
    "RomcomDiscoveredMovie": {
      "title": "RomcomDiscoveredMovie",
      "description": "An AI-curated romantic comedy movie persisted in the user's isolated Matinê discovery library.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Movie ID matching the document ID."
        },
        "title": {
          "type": "string",
          "maxLength": 180
        },
        "originalTitle": {
          "type": "string",
          "maxLength": 180
        },
        "searchTitle": {
          "type": "string",
          "maxLength": 180
        },
        "year": {
          "type": "number"
        },
        "imdbRating": {
          "type": "number"
        },
        "runtimeMinutes": {
          "type": "number"
        },
        "director": {
          "type": "string",
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "maxLength": 80
        },
        "subgenre": {
          "type": "string",
          "enum": [
            "Natal & Fim de Ano",
            "Clássico Romântico",
            "Inimigos a Amantes",
            "Falso Namoro",
            "Amigos a Amantes",
            "Segunda Chance",
            "Viagem & Destino",
            "Drama Romântico",
            "Internacional Rom-Com"
          ]
        },
        "secondaryTag": {
          "type": "string",
          "maxLength": 80
        },
        "obscurity": {
          "type": "string",
          "enum": ["Blockbuster", "Clássico", "Cult", "Lado B", "Raridade"]
        },
        "hasPtBrDub": {
          "type": "boolean"
        },
        "synopsis": {
          "type": "string",
          "maxLength": 600
        },
        "editorialNote": {
          "type": "string",
          "maxLength": 400
        },
        "isAiDiscovered": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "id",
        "title",
        "originalTitle",
        "year",
        "imdbRating",
        "runtimeMinutes",
        "director",
        "country",
        "subgenre",
        "obscurity",
        "hasPtBrDub",
        "synopsis",
        "isAiDiscovered",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExternalSeenChunk": {
      "title": "ExternalSeenChunk",
      "description": "A bounded chunk (up to 100 titles) of imported external watched movie titles used to avoid repeat recommendations.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "titles": {
          "type": "array",
          "description": "Up to 100 imported watched movie title strings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "chunkId", "titles", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile root document per authenticated user."
    },
    "/users/{userId}/entries/{movieId}": {
      "schema": { "$ref": "#/entities/MovieEntry" },
      "description": "Nocturna (Horror & Thriller) movie decisions, sentiment, and personal ratings."
    },
    "/users/{userId}/discoveredMovies/{movieId}": {
      "schema": { "$ref": "#/entities/DiscoveredMovie" },
      "description": "Nocturna (Horror & Thriller) AI-curated movies synced across devices."
    },
    "/users/{userId}/externalSeen/{chunkId}": {
      "schema": { "$ref": "#/entities/ExternalSeenChunk" },
      "description": "Nocturna (Horror & Thriller) bounded chunks of imported watched titles."
    },
    "/users/{userId}/romcomEntries/{movieId}": {
      "schema": { "$ref": "#/entities/MovieEntry" },
      "description": "Matinê (Romantic Comedy) isolated movie decisions, sentiment, and personal ratings."
    },
    "/users/{userId}/romcomDiscoveredMovies/{movieId}": {
      "schema": { "$ref": "#/entities/RomcomDiscoveredMovie" },
      "description": "Matinê (Romantic Comedy) isolated AI-curated movies synced across devices."
    },
    "/users/{userId}/romcomExternalSeen/{chunkId}": {
      "schema": { "$ref": "#/entities/ExternalSeenChunk" },
      "description": "Matinê (Romantic Comedy) isolated bounded chunks of imported watched titles."
    }
  }
}
